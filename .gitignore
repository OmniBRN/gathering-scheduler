### Secrets ###
# Real credentials never get committed; the .example template does.
.env
.env.*
!.env.example
# Local Spring config overrides (see spring.profiles.active=local)
**/src/main/resources/application-local.yaml
**/src/main/resources/application-local.yml
**/src/main/resources/application-local.properties
*.pem
*.key
*.p12
*.jks

### Java / Maven ###
target/
!**/src/main/**/target/
!**/src/test/**/target/
*.class
*.jar
*.war
*.ear
!**/.mvn/wrapper/*.jar
build/
!**/src/**/build/
.gradle/

# NOTE: .mvn/ is deliberately NOT ignored. With the jar-less Maven wrapper
# (distributionType=only-script), .mvn/wrapper/maven-wrapper.properties is the
# only thing that tells mvnw which Maven to download. Ignoring it breaks the
# build for every fresh clone.

